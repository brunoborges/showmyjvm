<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.brunoborges.showmyjvm</groupId>
    <artifactId>showmyjvm-bom</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <relativePath>../bom</relativePath>
  </parent>

  <artifactId>showmyjvm-quarkus</artifactId>
  <version>1.0.0-SNAPSHOT</version>

  <name>ShowMyJVM with Quarkus REST API</name>
  <description>A simple Quarkus REST API to expose the JVM details.</description>

  <properties>
    <quarkus.platform.version>3.40.1</quarkus.platform.version>
    <java.version>25</java.version>
    <quarkus.container-image.build>true</quarkus.container-image.build>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-bom</artifactId>
        <version>${quarkus.platform.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.brunoborges.showmyjvm</groupId>
      <artifactId>showmyjvm-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.brunoborges.showmyjvm</groupId>
      <artifactId>showmyjvm-web-ui</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-rest-jackson</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>io.quarkus</groupId>
      <artifactId>quarkus-container-image-jib</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>io.quarkus</groupId>
        <artifactId>quarkus-maven-plugin</artifactId>
        <version>${quarkus.platform.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <systemProperties>
            <quarkus.http.host>0.0.0.0</quarkus.http.host>
          </systemProperties>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <java.util.logging.manager>org.jboss.logmanager.LogManager</java.util.logging.manager>
            <maven.home>${maven.home}</maven.home>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>brewlet</id>
      <properties>
        <quarkus.container-image.build>false</quarkus.container-image.build>
        <quarkus.package.jar.type>uber-jar</quarkus.package.jar.type>
        <brewlet.image>${project.artifactId}:${project.version}</brewlet.image>
      </properties>
      <build>
        <plugins>
          <plugin>
            <groupId>sh.brewlet</groupId>
            <artifactId>brewlet-maven-plugin</artifactId>
            <version>0.6.1</version>
            <configuration>
              <image>${brewlet.image}</image>
              <!-- Quarkus needs its build-generated bytecode, so ship the uber-jar as one layer. -->
              <jarFile>${project.build.directory}/${project.build.finalName}-runner.jar</jarFile>
              <jdkFeature>${java.version}</jdkFeature>
            </configuration>
            <executions>
              <execution>
                <id>brewlet-image</id>
                <phase>package</phase>
                <goals>
                  <goal>config</goal>
                  <goal>build</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>